# Skopiuj ten plik jako ".env" i wpisz swoje dane do polaczenia z PostgreSQL

# Adres serwera PostgreSQL (jesli baza jest na tym samym komputerze, zostaw "localhost")
PGHOST=localhost

# Port PostgreSQL (domyslnie 5432)
PGPORT=5432

# Nazwa bazy danych (musi juz istniec - patrz README.md, sekcja "Baza danych")
PGDATABASE=mechanikapp

# Dane logowania do PostgreSQL
PGUSER=postgres
PGPASSWORD=TwojeHaslo123!

# Wlacz polaczenie SSL do bazy danych (np. baza hostowana w chmurze) - true/false
PGSSL=false

# Port, na ktorym wystartuje backend (API)
PORT=4000

# --- Wysylka maili przez Microsoft Graph API (Azure AD) ---
# (powiadomienia o zakonczonych robotach do szefa/kierownika)
# Wpisz tu dane aplikacji zarejestrowanej w Azure AD (App registrations).
# Jesli MICROSOFT_TENANT_ID zostanie puste, wysylka po prostu sie nie wykona (bez bledu).

# Tenant ID Twojej organizacji (Azure Portal > Azure Active Directory > Overview)
MICROSOFT_TENANT_ID=

# Client ID aplikacji zarejestrowanej w Azure AD
MICROSOFT_CLIENT_ID=

# Client Secret aplikacji (Azure AD > App registrations > Twoja aplikacja > Certificates & secrets)
MICROSOFT_CLIENT_SECRET=

# Konto/skrzynka z ktorej wysylane sa maile
# (musi miec uprawnienie aplikacji Mail.Send nadane w Azure AD - API permissions)
EMAIL_FROM_ADDRESS=warsztat@przyklad.pl
EMAIL_FROM_NAME=IT System Ewidencji
